# UBLDA Decision Center configuration reference
#
# This file contains placeholders only. Do not add a real token or secret here.
# Copy the browser variables you need to `.env.local` for local live-mode work.

# Browser-visible Vite variables (local `.env.local` and Vercel build environment)
VITE_CONVEX_URL=https://example-deployment.convex.cloud
VITE_LOGTO_ENDPOINT=https://example.logto.app
VITE_LOGTO_APP_ID=replace_with_logto_spa_app_id
# Optional local override. Production defaults to live and fails closed.
# VITE_DECISION_CENTER_MODE=demo

# Server-only Vercel Function variables
CONVEX_SITE_URL=https://example-deployment.convex.site
# Generate a separate random value of at least 32 visible ASCII characters.
# Set the identical value in Vercel and the Convex deployment; never expose it
# through a VITE_* variable.
DECISION_AGENT_GATEWAY_SECRET=replace_with_a_random_server_only_secret
DECISION_AGENT_ALLOWED_ORIGINS=http://localhost:5173,https://decisions.example.invalid

# Convex deployment variables
# These are listed here for discoverability, but Convex does not read them from
# this file. Set them with `npx convex env set` or in the Convex dashboard.
LOGTO_ISSUER=https://example.logto.app/oidc
LOGTO_APP_ID=replace_with_logto_spa_app_id
BOOTSTRAP_ADMIN_EMAILS=first.admin@example.invalid
# Same server-only value used by the Vercel gateway above.
# DECISION_AGENT_GATEWAY_SECRET=replace_with_a_random_server_only_secret
