{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "www.ublda.org" }
      ],
      "destination": "https://ublda.org/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://*.logto.app https://*.convex.cloud https://*.convex.site wss://*.convex.cloud; upgrade-insecure-requests" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/convex-auth", "destination": "/api/decision-agent?decisionAgentPath=/convex-auth" },
    { "source": "/mcp", "destination": "/api/decision-agent?decisionAgentPath=/mcp" },
    { "source": "/api/decision-agent/:path*", "destination": "/api/decision-agent?decisionAgentPath=/:path*" },
    { "source": "/api/facilities", "destination": "/api/housing?housingPath=/facilities" },
    { "source": "/api/facilities/:id/availability", "destination": "/api/housing?housingPath=/facilities/:id/availability" },
    { "source": "/api/facilities/:id", "destination": "/api/housing?housingPath=/facilities/:id" },
    { "source": "/api/map/layers/:layer", "destination": "/api/housing?housingPath=/map/layers/:layer" },
    { "source": "/api/analytics/geographies/:id", "destination": "/api/housing?housingPath=/analytics/geographies/:id" },
    { "source": "/api/provider/claim-facility", "destination": "/api/housing?housingPath=/provider/claim-facility" },
    { "source": "/api/submissions/facility-correction", "destination": "/api/housing?housingPath=/submissions/facility-correction" },
    { "source": "/api/referrals", "destination": "/api/housing?housingPath=/referrals" },
    { "source": "/api/admin/review-queue", "destination": "/api/housing?housingPath=/admin/review-queue" },
    { "source": "/api/recruiting-export", "destination": "/api/recruiting?recruitingPath=/recruiting-export" },
    { "source": "/api/recruiting-health", "destination": "/api/recruiting?recruitingPath=/recruiting-health" },
    { "source": "/api/resume", "destination": "/api/recruiting?recruitingPath=/resume" },
    { "source": "/((?!api/|assets/|src/|@vite/|@react-refresh|@id/|node_modules/|favicon\\.svg|logo\\.svg|highlights/|partners-blda\\.webp).*)", "destination": "/index.html" }
  ]
}
