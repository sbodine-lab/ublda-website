{
  "name": "ublda-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:store": "esbuild server/localRecruitingStore.ts --bundle --platform=node --format=esm --packages=external --outfile=server/localRecruitingStore.js",
    "prebuild": "npm run build:store",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "pretest": "npm run build:store",
    "test": "node --experimental-strip-types --test tests/**/*.test.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vercel/blob": "^2.3.3",
    "bcryptjs": "^3.0.3",
    "framer-motion": "^12.35.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "playwright": "^1.59.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}
