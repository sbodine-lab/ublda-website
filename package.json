{
  "name": "ublda-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:store": "esbuild server/speakerOpsStore.ts --bundle --platform=node --format=esm --packages=external --allow-overwrite --outfile=server/speakerOpsStore.js && esbuild server/speakerOpsService.ts --bundle --platform=node --format=esm --packages=external --allow-overwrite --outfile=server/speakerOpsService.js && esbuild server/operationsStore.ts --bundle --platform=node --format=esm --packages=external --allow-overwrite --outfile=server/operationsStore.js && esbuild server/operationsService.ts --bundle --platform=node --format=esm --packages=external --allow-overwrite --outfile=server/operationsService.js",
    "prebuild": "npm run build:store",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck:convex": "tsc -p convex/tsconfig.json --noEmit",
    "check:decisions": "npm run typecheck:convex && node --experimental-strip-types --test tests/decision-*.test.ts",
    "pretest": "npm run build:store",
    "test": "node --experimental-strip-types --test tests/**/*.test.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@logto/react": "^4.0.14",
    "@modelcontextprotocol/server": "^2.0.0",
    "@paper-design/shaders-react": "^0.0.80",
    "@vercel/blob": "^2.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.43.0",
    "framer-motion": "^12.35.1",
    "jose": "^6.2.8",
    "lenis": "^1.3.26",
    "lucide-react": "^1.31.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.13.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "playwright": "^1.59.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}
